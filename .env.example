# Same Postgres instance the backend uses (direct connection preferred here,
# not the PgBouncer pooler -- this pipeline runs long transactions, unlike
# the backend's short request-scoped queries)
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# MAPID API -- Properti Go / Struk Go / Menu Go. Not yet available per earlier
# discussion; pipeline runs with ingestion/mapid.py stubbed until this exists.
MAPID_API_BASE_URL=https://api.mapid.io
MAPID_API_KEY=

# Gemini -- narrative synthesis, same pattern as before: blank key -> stub output
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-2.5

# Study area (Dukuh Atas + Blok M corridor) -- WGS84 bounding box
STUDY_AREA_BBOX_NORTH=-6.1880
STUDY_AREA_BBOX_SOUTH=-6.2450
STUDY_AREA_BBOX_EAST=106.8300
STUDY_AREA_BBOX_WEST=106.7980

GRID_CELL_SIZE_M=250
PROJECTED_CRS=EPSG:32748
